{
  "FoodYou_Thm_01": {
    "id": "app_001",
    "task_key": "FoodYou_Thm_01",
    "task_id": "task_001_theme",
    "name": "foodyou",
    "app_package": "com.maksimowiczm.foodyou",
    "target_activity": "com.maksimowiczm.foodyou.app.infrastructure.android.MainActivity",
    "build_command": "gradlew.bat assembleDebug",
    "apk_path": "app/build/outputs/apk/debug/app-debug.apk",
    "prompt": "This is the source code of a healthy diet app. I noticed that it currently has three theme styles: \"System\", \"Light\", and \"Dark\". I would like to add a new theme called \"Girly Skull\". This theme should use a pink color scheme, with skull elements incorporated into the buttons and background images.",
    "navigation_steps": [
      {
        "action": "click_optional",
        "xpath": "//*[@resource-id='android:id/button1' or @text='好的' or @text='OK' or @text='确 定']"
      },
      {
        "action": "click_optional",
        "xpath": "//*[contains(@text, '同意') or contains(@text, 'Agree')]"
      },
      {
        "action": "click_optional",
        "xpath": "//*[@text='跳过' or @text='Skip']"
      },
      {
        "action": "click_optional",
        "xpath": "//*[@content-desc='关闭工作表']"
      },
      {
        "action": "click",
        "xpath": "//*[@content-desc='前往设置' or @content-desc='Settings' or @content-desc='设置']"
      },
      {
        "action": "click",
        "xpath": "//*[contains(@text, '个性化') or contains(@text, 'Personalization')]"
      },
      {
        "action": "click",
        "xpath": "//*[contains(@text, '颜色') or contains(@text, 'Color') or contains(@text, 'Colour')]"
      }
    ],
    "target_ui_verification": {
      "type": "xpath",
      "value": "//*[contains(@text, 'Girly Skull') or contains(@text, '少女骷髅')]",
      "action": "exists"
    }
  },
